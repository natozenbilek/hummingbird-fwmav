# BLE (Bluedroid host) — Android uygulamasıyla bağlantı için
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y

# ESP-IDF v5.3 ESP32-C3'te legacy advertising API (esp_ble_gap_start_advertising,
# esp_ble_gap_config_adv_data) BLE 4.2 feature flag'ine bağlıdır. Explicit aç.
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=y

# Bluedroid + uygulama kodu varsayılan partition'a sığmaz.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
